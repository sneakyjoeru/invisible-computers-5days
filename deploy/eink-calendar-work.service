[Unit]
Description=E-Ink Calendar (work) 800x480 image + Google auth (low priority)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=orangepi
WorkingDirectory=/opt/eink-calendar-work
Environment=OPEN_MODE=1
Environment=SSL_ENABLED=1
Environment=APP_PORT=8890
Environment=EINK_CONFIG_DIR=/opt/eink-calendar-work/config
ExecStartPre=/opt/eink-calendar-work/.venv/bin/python -c "from app import config; config.ensure_ssl_cert()"
ExecStart=/opt/eink-calendar-work/.venv/bin/python -m uvicorn app.mac_main:app --host 0.0.0.0 --port 8890 --ssl-certfile /opt/eink-calendar-work/config/ssl/cert.pem --ssl-keyfile /opt/eink-calendar-work/config/ssl/key.pem --log-level info
Restart=on-failure
RestartSec=10
Nice=15
CPUWeight=20
IOWeight=20
CPUSchedulingPolicy=batch

[Install]
WantedBy=multi-user.target
